---
permalink: /sitemap.xml
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
{%- if p.layout == 'default' and p.noindex != true %}
  <url>
    <loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc>
{%- if p.last_modified_at %}
    <lastmod>{{ p.last_modified_at | date: "%Y-%m-%d" }}</lastmod>
{%- endif %}
  </url>
{%- endif -%}
{%- endfor %}
</urlset>
